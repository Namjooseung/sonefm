{
  "contract": 1,
  "id": "sonefm-schedule",
  "name": "SoneFM 편성표",
  "version": "1.1.0",
  "cli": { "exe": ["SoneFM.exe", "--cli"], "dev": [".venv/Scripts/python.exe", "app/main.py", "--cli"] },
  "gui": { "exe": ["SoneFM.exe"], "dev": [".venv/Scripts/python.exe", "app/main.py"] },
  "commands": {
    "lookup": {
      "summary": "날짜·시각에 나가는 프로그램 이름과 회차 (회차는 편성표 계산 그대로)",
      "timeout": 60,
      "input": {
        "date": { "type": "date", "required": true, "help": "방송 날짜 YYYY-MM-DD" },
        "hour": { "type": "int", "required": true, "help": "시작 시각 6~22" },
        "db": { "type": "file", "required": false, "help": "편성 데이터 파일. 없으면 이 PC의 편성 데이터" }
      },
      "output": {
        "name": "프로그램 이름",
        "episode": "회차. 회차를 숨기는 프로그램(고정 편성 등)이면 null",
        "kind": "본방 또는 재방",
        "label": "제목용 이름 (예: '마을살이 정류장 41회', 회차 숨김이면 이름만)",
        "category": "교양 또는 오락",
        "program_id": "프로그램 id",
        "prep_status": "송출 파일 준비 상태 (미입고/입고/송출완료 또는 null)",
        "month_status": "그 달 편성 상태 (미작성/작성중/확정/마감)"
      }
    },
    "month": {
      "summary": "한 달 편성 전체 (편성표 화면과 같은 결과)",
      "timeout": 120,
      "input": {
        "year": { "type": "int", "required": true },
        "month": { "type": "int", "required": true },
        "db": { "type": "file", "required": false }
      },
      "output": { "cells": "'YYYY-MM-DD|시' → 칸 정보", "weeks": "주 목록", "status": "월 상태", "issues": "검증 결과" }
    },
    "set-prep": {
      "summary": "칸의 송출 파일 준비 상태 바꾸기 (마감된 달은 거부)",
      "timeout": 60,
      "input": {
        "date": { "type": "date", "required": true },
        "hour": { "type": "int", "required": true },
        "status": { "type": "string", "required": true, "help": "미입고 / 입고 / 송출완료" },
        "db": { "type": "file", "required": false }
      },
      "output": { "prep_status": "바뀐 상태" }
    },
    "check-db": {
      "summary": "받은 편성 데이터 파일이 쓸 수 있는 파일인지 검사하고 이 버전 형식으로 맞춤 (사본에만 쓸 것)",
      "timeout": 60,
      "input": { "db": { "type": "file", "required": true } },
      "output": { "month_statuses": "올해 월별 편성 상태" }
    }
  }
}
